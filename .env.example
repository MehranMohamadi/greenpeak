# Backend-only LLM keys. Replace placeholders; never use NEXT_PUBLIC_*.
# Keep this JSON array on ONE line. Priority: Gemini -> Cloudflare Workers AI.
# With this list set, the legacy single-provider settings (including GapGPT) are unused.
GREENPEAK_LLM_PROVIDERS='[{"provider_id":"gemini","model":"gemini-3.1-flash-lite","api_key":"YOUR_GEMINI_KEY","base_url":"https://generativelanguage.googleapis.com/v1beta/openai"},{"provider_id":"cloudflare","model":"@cf/qwen/qwen3-30b-a3b-fp8","api_key":"YOUR_CLOUDFLARE_API_TOKEN","base_url":"https://api.cloudflare.com/client/v4/accounts/YOUR_CLOUDFLARE_ACCOUNT_ID/ai/v1"}]'
# Cloudflare: Workers AI -> Use REST API -> Create a Workers AI API Token.
# Replace YOUR_CLOUDFLARE_ACCOUNT_ID inside base_url with the Account ID from that page.
# Stay on Workers Free: 10,000 Neurons/day; resets at 00:00 UTC.
# Free-only usage requires free-plan accounts; routing cannot detect paid billing.
# Optional persistent cooldown database (defaults to backend2/instance/llm_router.db).
# GREENPEAK_LLM_ROUTER_DB_PATH=C:/path/to/greenpeak/backend2/instance/llm_router.db
# Later, append a third provider object inside the array above, separated by a comma:
# {"provider_id":"third","model":"YOUR_THIRD_MODEL","api_key":"YOUR_THIRD_KEY","base_url":"https://your-provider.example/v1"}

# Chat history uses persistent local SQLite storage (one application host).
GREENPEAK_CHAT_RETENTION_DAYS=30
GREENPEAK_CHAT_DAILY_LIMIT=100
GREENPEAK_CHAT_MT5_STALE_MINUTES=5
# Optional: GREENPEAK_CHAT_DB_PATH=/persistent/greenpeak/chat.db

# Email authentication (backend only). Use a random secret in production.
AUTH_SECRET_KEY=development-only-change-me
AUTH_PUBLIC_URL=http://localhost:3000
AUTH_EMAIL_TOKEN_TTL_SECONDS=3600
RESEND_API_KEY=
AUTH_EMAIL_FROM=
