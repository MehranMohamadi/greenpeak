GREENPEAK_LLM_PROVIDER=openai-compatible
GREENPEAK_LLM_MODEL=gpt-6-luna
GREENPEAK_LLM_BASE_URL=https://api.gapgpt.app/v1
GREENPEAK_LLM_API_KEY=

# Authentication (backend). Never use the development secret in production.
AUTH_SECRET_KEY=development-only-change-me
AUTH_PUBLIC_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
AUTH_EMAIL_TOKEN_TTL_SECONDS=3600
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
