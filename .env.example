GREENPEAK_LLM_PROVIDER=openai-compatible
GREENPEAK_LLM_MODEL=gpt-6-luna
GREENPEAK_LLM_BASE_URL=https://api.gapgpt.app/v1
GREENPEAK_LLM_API_KEY=

# Chat history uses persistent local SQLite storage (one application host).
GREENPEAK_CHAT_RETENTION_DAYS=30
GREENPEAK_CHAT_DAILY_LIMIT=100
GREENPEAK_CHAT_MT5_STALE_MINUTES=5
# Optional: GREENPEAK_CHAT_DB_PATH=/persistent/greenpeak/chat.db

# Email authentication (backend only). Use a random secret in production.
AUTH_SECRET_KEY=development-only-change-me
AUTH_PUBLIC_URL=http://localhost:3000
AUTH_EMAIL_TOKEN_TTL_SECONDS=3600
RESEND_API_KEY=
AUTH_EMAIL_FROM=
