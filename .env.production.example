# FastAPI production configuration
ENVIRONMENT=production
DEBUG=false
RELOAD=false
HOST=127.0.0.1
PORT=8000
WORKERS=2

# Browser origins allowed to call FastAPI
CORS_ORIGINS=["https://greenpeak.ir","https://www.greenpeak.ir"]

# Data providers (server-side only)
FRED_API_KEY=replace_with_fred_api_key
ALPHA_VANTAGE_KEY=replace_with_alpha_vantage_api_key
MONGODB_URL=mongodb://replace_with_production_connection
MONGODB_DATABASE=sp500_dashboard

# Daily server-side Alpha Vantage news cache (optional overrides)
NEWS_SENTIMENT_CACHE_PATH=.cache/news-sentiment.json
NEWS_SENTIMENT_CACHE_TTL_MS=86400000
NEWS_SENTIMENT_PER_TOPIC_LIMIT=1000

# Optional deterministic analysis pipeline settings
GREENPEAK_ENABLE_PIPELINE_PREVIEW=false
GREENPEAK_LLM_PROVIDER=disabled
GREENPEAK_LLM_MODEL=
GREENPEAK_LLM_API_KEY=
GREENPEAK_LLM_BASE_URL=https://api.openai.com/v1
GREENPEAK_ANALYSIS_ADMIN_TOKEN=replace_with_random_admin_token

# MT5 snapshot ingestion and server-side Dashboard reader.
# Use the same strong token for both values; never expose it with NEXT_PUBLIC_*.
GREENPEAK_MT5_API_TOKENS=replace_with_strong_mt5_token
GREENPEAK_MT5_DASHBOARD_TOKEN=replace_with_strong_mt5_token
GREENPEAK_INTERNAL_API_BASE_URL=http://127.0.0.1:8000/api/v1
GREENPEAK_NEWS_ENABLED=false
GREENPEAK_CNBC_RSS_URL=https://www.cnbc.com/id/10000664/device/rss/rss.html
GREENPEAK_INVESTING_RSS_URL=https://www.investing.com/rss/news_25.rss
