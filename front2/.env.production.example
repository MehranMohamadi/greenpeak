# Public URL compiled into the Next.js browser bundle
NEXT_PUBLIC_APP_URL=https://greenpeak.ir
NEXT_PUBLIC_API_BASE_URL=https://greenpeak.ir/api/v1

# Server-side Next.js route handlers; never prefix these with NEXT_PUBLIC_
ALPHA_VANTAGE_KEY=replace_with_alpha_vantage_api_key
FRED_API_KEY=replace_with_fred_api_key
